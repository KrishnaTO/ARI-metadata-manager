        <componentRelevance>Apoptosis</componentRelevance>
        <mediatorDescription>Death receptor on beta-cells</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <rdfs:label>Fas (CD95)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Rec_IL2R -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Rec_IL2R">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Receptor"/>
        <componentRelevance>Treg</componentRelevance>
        <mediatorDescription>Treg maintenance; GWAS locus</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <rdfs:label>IL-2R (CD25)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Rec_PD1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Rec_PD1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Receptor"/>
        <componentRelevance>Exhaustion</componentRelevance>
        <mediatorDescription>Inhibitory; T1D polymorphisms</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <rdfs:label>PD-1 (CD279)</rdfs:label>
    </owl:NamedIndividual>
    


