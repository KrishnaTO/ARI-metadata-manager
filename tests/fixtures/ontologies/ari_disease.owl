    <!-- http://www.aurint.org/ontologies/ari-disease#Et_ERStress -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Et_ERStress">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#EtiologyOrigin"/>
        <etiologyDescription>Unfolded protein response increases beta-cell immunogenicity</etiologyDescription>
        <etiologyExcerpt>&quot;ER stress in beta cells generates neoantigens that promote autoimmunity.&quot;</etiologyExcerpt>
        <etiologyOriginType>Idiopathic</etiologyOriginType>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/30269450/</sourcePMID>
        <ARI_Obsolete>false</ARI_Obsolete>
        <rdfs:label>Beta-cell ER stress</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Et_Genetic -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Et_Genetic">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#EtiologyOrigin"/>
        <etiologyDescription>~50% MZ twin concordance; polygenic risk (HLA, INS, PTPN22, CTLA4, IL2RA, IFIH1)</etiologyDescription>
        <etiologyExcerpt>&quot;The HLA region accounts for approximately 50% of the genetic risk of type 1 diabetes.&quot;</etiologyExcerpt>
        <etiologyOriginType>Genetic</etiologyOriginType>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/21447697/</sourcePMID>
        <ARI_Obsolete>false</ARI_Obsolete>
        <rdfs:label>Genetic susceptibility</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Et_Mimicry -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Et_Mimicry">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#EtiologyOrigin"/>
        <etiologyDescription>Coxsackie P2-C / GAD65 homology drives cross-reactive T-cells</etiologyDescription>
        <etiologyExcerpt>&quot;Sequence homology between Coxsackievirus P2-C and GAD65 may elicit cross-reactive responses.&quot;</etiologyExcerpt>
        <etiologyOriginType>External</etiologyOriginType>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/24814487/</sourcePMID>
        <ARI_Obsolete>false</ARI_Obsolete>
        <rdfs:label>Molecular mimicry</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Et_Tolerance -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Et_Tolerance">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#EtiologyOrigin"/>
        <etiologyDescription>Defective central/peripheral tolerance; impaired Treg function</etiologyDescription>
        <etiologyExcerpt>&quot;Breakdown of self-tolerance to beta-cell antigens underlies disease initiation.&quot;</etiologyExcerpt>
        <etiologyOriginType>Idiopathic</etiologyOriginType>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <ARI_Obsolete>false</ARI_Obsolete>
        <rdfs:label>Loss of immune tolerance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Et_Viral -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Et_Viral">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#EtiologyOrigin"/>
        <etiologyDescription>Enterovirus precedes seroconversion; viral RNA detected in islets</etiologyDescription>
        <etiologyExcerpt>&quot;Enteroviral infection is associated with the appearance of islet autoimmunity and clinical type 1 diabetes.&quot;</etiologyExcerpt>
        <etiologyOriginType>External</etiologyOriginType>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/28958587/</sourcePMID>
        <ARI_Obsolete>false</ARI_Obsolete>
        <rdfs:label>Viral trigger</rdfs:label>
    </owl:NamedIndividual>
    


