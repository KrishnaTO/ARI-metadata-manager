        <ARI_ClinicalSubtype>Paraneoplastic Pemphigus - Linked to underlying malignancy.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Pemphigus Foliaceus - Affects the skin, no mucosal involvement.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Pemphigus Vulgaris - Painful blisters on skin and mucous membranes.</ARI_ClinicalSubtype>
        <ARI_DOID>9182</ARI_DOID>
        <ARI_DXCODE>46459009, 200907003, 65172003, 36739006, 35154004, 402718003, 49420001</ARI_DXCODE>
        <ARI_DefSource>Wertenteil 2019; https://pubmed.ncbi.nlm.nih.gov/30892569/</ARI_DefSource>
        <ARI_ICD10>694.4</ARI_ICD10>
        <ARI_ICD10>L10</ARI_ICD10>
