    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#NET_MPO -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#NET_MPO">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#NETosisComponent"/>
        <componentRelevance>Inflammatory marker</componentRelevance>
        <mediatorDescription>NET-associated enzyme; elevated neutrophil activity in new-onset T1D</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <rdfs:label>Myeloperoxidase (MPO)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#NET_NETs -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#NET_NETs">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#NETosisComponent"/>
        <componentRelevance>Early autoimmunity</componentRelevance>
        <mediatorDescription>Increased NETosis precedes T1D onset; NET components deposit in islets</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <rdfs:label>Neutrophil extracellular traps (NETs)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#NET_PAD4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#NET_PAD4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#NETosisComponent"/>
        <componentRelevance>Neoantigen generation</componentRelevance>
        <mediatorDescription>Peptidylarginine deiminase 4 drives NET formation and neoantigen citrullination</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <rdfs:label>PAD4 (citrullination)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_1_Genetic -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_1_Genetic">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <stepCategory>Genetic</stepCategory>
        <stepDescription>HLA-DR3/DR4-DQ, INS VNTR, PTPN22, CTLA4 establish a permissive genetic background.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Genetic susceptibility</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_2_Trigger -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_2_Trigger">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/28958587/</sourcePMID>
        <stepCategory>Trigger</stepCategory>
        <stepDescription>Enteroviral infection or dietary antigens precipitate islet autoimmunity in genetically susceptible hosts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Environmental trigger</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_3_Tolerance -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_3_Tolerance">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <stepCategory>Immune</stepCategory>
        <stepDescription>Impaired central/peripheral tolerance and defective Treg function permit autoreactive clones.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Loss of immune tolerance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_4_Presentation -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_4_Presentation">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <stepCategory>Immune</stepCategory>
        <stepDescription>Dendritic cells and macrophages present beta-cell antigens in pancreatic lymph nodes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Antigen presentation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_5_Autoantibodies -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_5_Autoantibodies">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <stepCategory>Antibody</stepCategory>
        <stepDescription>B-cells produce GADA, IA-2A, IAA and ZnT8A, the serological hallmark of islet autoimmunity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Autoantibody production</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_6_Insulitis -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_6_Insulitis">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <stepCategory>Immune</stepCategory>
        <stepDescription>CD8+ cytotoxic and CD4+ Th1 cells infiltrate the islets (insulitis).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</stepOrder>
        <rdfs:label>T-cell insulitis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_7_BetaDeath -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_7_BetaDeath">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/30269450/</sourcePMID>
        <stepCategory>TissueDamage</stepCategory>
        <stepDescription>Perforin/granzyme, Fas-FasL and cytokine (IL-1B, IFN-g, TNF) toxicity destroy beta cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</stepOrder>
        <rdfs:label>Beta-cell destruction</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_8_Insulin -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_8_Insulin">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/30609683/</sourcePMID>
        <stepCategory>Outcome</stepCategory>
        <stepDescription>Loss of &gt;80-90% beta-cell mass yields absolute insulin deficiency and clinical hyperglycemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</stepOrder>
        <rdfs:label>Insulin deficiency &amp; hyperglycemia</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Rec_CTLA4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Rec_CTLA4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Receptor"/>
        <componentRelevance>Checkpoint</componentRelevance>
        <mediatorDescription>Checkpoint; reduced in T1D</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <rdfs:label>CTLA-4 (CD152)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Rec_Fas -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Rec_Fas">
