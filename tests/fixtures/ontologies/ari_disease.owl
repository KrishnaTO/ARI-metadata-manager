        <ARI_Author>Suhani Dalal</ARI_Author>
        <ARI_AuthorDate>2024-09</ARI_AuthorDate>
        <ARI_ChangeLog>2026-06-15 10:37 | Importer | Imported from ARI core reports</ARI_ChangeLog>
        <ARI_ClinicalSubtype>Hypersensitivity Angiitis, Cutaneous - Limited to the skin.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Hypersensitivity Angiitis, Systemic - Affects internal organs.</ARI_ClinicalSubtype>
        <ARI_DOID>9809</ARI_DOID>
        <ARI_DXCODE>60555002</ARI_DXCODE>
        <ARI_ICD10>446.2</ARI_ICD10>
