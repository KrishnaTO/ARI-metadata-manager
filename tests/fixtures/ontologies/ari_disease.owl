        <ARI_ClinicalSubtype>Intermediate Uveitis, Associated - Linked to conditions like multiple sclerosis or sarcoidosis.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Intermediate Uveitis, Isolated - No associated systemic disease.</ARI_ClinicalSubtype>
        <ARI_DOID>12732</ARI_DOID>
        <ARI_DXCODE>314429009</ARI_DXCODE>
