# ===== Server-side only. NEVER expose these to the browser. =====
# GitHub OAuth App credentials (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Repo the app reads ontology data from and writes ontology PRs to
GITHUB_OWNER=KrishnaTO
GITHUB_REPO=ARI
GITHUB_BASE_BRANCH=main
GITHUB_ONTOLOGY_PATH=ontologies/ari_disease.owl
GITHUB_SYNONYM_REVIEW_PATH=data/4-reports/9_Synonym_Review.tsv
# Server-side token used by the deploy/update-*.sh refresh scripts. Required on a
# server: the ontology refresh makes 9 requests a run, past the anonymous limit.
# Leave blank for local runs.
GITHUB_SERVICE_TOKEN=

# Mapping files format:
# ARI_MAPPING_FILES="remote_path_in_repo:local_path"
# Multiple mappings should be separated by newlines inside the variable.
# Example (the built-in defaults):
# ARI_MAPPING_FILES="mappings/ari.equivalencies.tsv:/opt/ari/ari-metadata-manager/ari-mappings/ari.equivalencies.tsv
# mappings/ari.sssom.tsv:/opt/ari/ari-metadata-manager/ari-mappings/ari.sssom.tsv
# mappings/ari.synonym_blocklist.tsv:/opt/ari/ari-metadata-manager/ari-mappings/ari.synonym_blocklist.tsv"
# Leave unset to use the built-in defaults. The app reads the local copies from
# ari-mappings/, so keep local paths there; never point them at the tracked
# files under mappings/ (update.sh resets those on every run).
# A list that leaves out mappings/ari.synonym_blocklist.tsv stops prediction: the
# app refuses to predict without the blocklist.
ARI_MAPPING_FILES=

# Public URL of this app (must match the OAuth App callback URL).
# When behind nginx with a subpath prefix, include it:
#   https://aurint.ca/ari-editor
# For local dev:
#   http://localhost:8001
APP_BASE_URL=https://aurint.ca/ari-editor
OAUTH_CALLBACK_PATH=/auth/github/callback

# Branch of this app repo (ARI-metadata-manager) that deploy/update.sh tracks
APP_REPO_BRANCH=main
# systemd unit deploy/update.sh restarts, and the port it reads /healthz on (PORT,
# below). The staging copy sets ari-mm-staging and 8002 (STAGING.md).
APP_SERVICE=ari-mm

# Long random string for signing the session cookie (e.g. `openssl rand -hex 32`).
# REQUIRED wherever GitHub sign-in is configured — the app refuses to start
# without it. A per-process random key signs every curator out on each restart,
# and the deploy timer restarts every ten minutes.
# Do not quote the value; write it bare.
SESSION_SECRET=replace_with_64_hex_chars

# Days a sign-in stays valid before it is swept from .sessions.json. 0 disables
# the sweep (not recommended: the store holds live GitHub tokens).
SESSION_TTL_DAYS=30

# Comma-separated GitHub logins allowed to use the app. Empty means ANY GitHub
# user with repo access can sign in — fine for local development, but set it in
# production. Each sign-in with this unset is logged at WARNING.
ALLOWED_LOGINS=

# Comma-separated GitHub logins who may cut releases, use the mapping-PR
# reviewer, and change other curators' review queues and feedback.
# Empty = anyone signed in. Every curator can always manage their own queue.
ASSIGN_ADMINS=

PORT=8001
# Days to keep an idle per-user working copy (0 = never sweep). An idle copy that
# matches the base ontology is deleted; one with unpublished work is archived to
# .user-data/archive/ instead.
USER_DATA_TTL_DAYS=14

# ----- Optional; the defaults below apply when these stay commented out -----
# Runtime ontology file (run.py --file sets this).
# ARI_ONTOLOGY_FILE=/opt/ari/ari-metadata-manager/ontologies/ari_disease.owl
# ROBOT jar that formats every publish (deploy/install-robot.sh puts it here).
# Required when GitHub sign-in is configured; runs on the `java` on PATH (11+).
# ROBOT_JAR=/opt/ari/robot/robot.jar
# Mapping files: their path in the ARI repo, and under this repo's root.
# GITHUB_SSSOM_PATH=mappings/ari.sssom.tsv
# GITHUB_EQUIV_PATH=mappings/ari.equivalencies.tsv
# Licence asserted in the mapping files, shown to curators before they publish.
# MAPPING_LICENSE=https://creativecommons.org/publicdomain/zero/1.0/
# Curators' ontologies held in memory at once (least recently used are evicted).
# MAX_LOADED_WORLDS=8
