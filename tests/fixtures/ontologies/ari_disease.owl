        <ARI_ClinicalSubtype>Mixed Collagen Vascular Disease, Overlap Syndrome - Features from multiple autoimmune diseases.</ARI_ClinicalSubtype>
        <ARI_DOID>3492</ARI_DOID>
        <ARI_DXCODE>398049005</ARI_DXCODE>
