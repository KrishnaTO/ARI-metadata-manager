        <ARI_ClinicalSubtype>Myocarditis, Giant Cell - Severe form with rapid progression.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Myocarditis, Lupus-Associated - Occurs in systemic lupus erythematosus.</ARI_ClinicalSubtype>
        <ARI_DOID>0040095</ARI_DOID>
        <ARI_DXCODE>871640001, 37217002</ARI_DXCODE>
