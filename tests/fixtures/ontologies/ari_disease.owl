        <ARI_ClinicalSubtype>Fibromyalgia, Primary - No known cause, chronic widespread pain.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Fibromyalgia, Secondary - Occurs with other conditions like lupus or rheumatoid arthritis.</ARI_ClinicalSubtype>
        <ARI_DOID>631</ARI_DOID>
