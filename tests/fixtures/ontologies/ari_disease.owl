    <owl:NamedIndividual rdf:about="https://diseases.autoimmuneregistry.org/disease/ARI_0001038">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#AutoimmuneDisease"/>
        <hasEpidemiologyProfile rdf:resource="http://www.aurint.org/ontologies/ari-disease#Epi_a845fe37"/>
