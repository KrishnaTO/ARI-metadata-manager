        <ARI_ClinicalSubtype>Hyperacute/Fulminant ADEM - Severe, rapidly progressing form.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Monophasic ADEM - Single episode, most common form.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Multiphasic ADEM (MDEM) - Second episode with new lesions.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Recurrent ADEM - Multiple episodes without new triggers.</ARI_ClinicalSubtype>
