        <ARI_ChangeLog>2026-06-15 10:37 | Importer | Imported from ARI core reports</ARI_ChangeLog>
        <ARI_ChangeLog>2026-10-15T13:57:50+00:00 | migration (#229) | Moved to prevalence &amp; incidence figures: Prevalence US 606374.0/100k</ARI_ChangeLog>
        <ARI_ClinicalSubtype>Sarcoidosis, Cutaneous - Involves the skin with lupus pernio or erythema nodosum.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Sarcoidosis, Neurosarcoidosis - Affects the nervous system.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Sarcoidosis, Pulmonary - Affects the lungs, causing granulomas.</ARI_ClinicalSubtype>
        <ARI_DOID>11335</ARI_DOID>
        <ARI_DXCODE>72470008, 238676008, 31541009</ARI_DXCODE>
        <ARI_DefSource>Baughman 2016; https://pubmed.ncbi.nlm.nih.gov/27509154/</ARI_DefSource>
        <ARI_ICD10>135</ARI_ICD10>
        <ARI_ICD10>D86</ARI_ICD10>
        <ARI_ID>ARI:0001186</ARI_ID>
