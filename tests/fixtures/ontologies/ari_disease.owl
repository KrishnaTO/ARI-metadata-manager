        <ARI_ClinicalSubtype>Autoimmune Pancreatitis, Type 1 - IgG4-related disease with systemic involvement.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Autoimmune Pancreatitis, Type 2 - Primarily affects the pancreas, associated with inflammatory bowel disease.</ARI_ClinicalSubtype>
        <ARI_DOID>0040091</ARI_DOID>
