        <ARI_ClinicalSubtype>Autoimmune Thyroiditis, Hashimoto’s Thyroiditis - Leads to hypothyroidism.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Autoimmune Thyroiditis, Postpartum Thyroiditis - Occurs after pregnancy.</ARI_ClinicalSubtype>
        <ARI_DOID>7188</ARI_DOID>
