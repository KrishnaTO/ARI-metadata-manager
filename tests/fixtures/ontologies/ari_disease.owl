        <ARI_ClinicalSubtype>Hidradenitis Suppurativa, Hurley Stage I - Mild, isolated abscesses.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Hidradenitis Suppurativa, Hurley Stage II - Recurring abscesses with scarring.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Hidradenitis Suppurativa, Hurley Stage III - Extensive interconnected abscesses.</ARI_ClinicalSubtype>
        <ARI_DOID>2280</ARI_DOID>
