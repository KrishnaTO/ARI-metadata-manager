<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.aurint.org/ontologies/ari_biomarkers#"
     xml:base="http://www.aurint.org/ontologies/ari_biomarkers"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ari-disease="http://www.aurint.org/ontologies/ari-disease#">
    <owl:Ontology rdf:about="http://www.aurint.org/ontologies/ari_biomarkers">
        <owl:imports rdf:resource="http://www.aurint.org/ontologies/ari_chebi"/>
        <owl:imports rdf:resource="http://www.aurint.org/ontologies/ari_core"/>
        <owl:imports rdf:resource="http://www.aurint.org/ontologies/ari_hgnc"/>
        <owl:imports rdf:resource="http://www.aurint.org/ontologies/ari_loinc"/>
        <owl:imports rdf:resource="http://www.aurint.org/ontologies/ari_pr"/>
        <rdfs:comment>Shared ARI biomarker concepts: ARIB classes under Autoantibody, Antigen and ClinicalBiomarker. The test fixture holds the GAD65 antibody (with an IgG child) and antigen, an IA-2 antibody and one clinical biomarker.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
