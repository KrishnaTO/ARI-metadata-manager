        <ARI_ClinicalSubtype>Dressler Syndrome, Classic - Pericarditis after heart attack or surgery.</ARI_ClinicalSubtype>
        <ARI_DOID>10507</ARI_DOID>
        <ARI_DXCODE>827164008, 66189004, 58600007, 278536002</ARI_DXCODE>
        <ARI_DefSource>Miller 1988; https://pubmed.ncbi.nlm.nih.gov/3189147/</ARI_DefSource>
