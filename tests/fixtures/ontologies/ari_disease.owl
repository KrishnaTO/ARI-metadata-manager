        <ARI_ClinicalSubtype>Limited Sclerosis, CREST Syndrome - Calcinosis, Raynaud’s, esophageal dysfunction, sclerodactyly, telangiectasia.</ARI_ClinicalSubtype>
        <ARI_DOID>1577</ARI_DOID>
        <ARI_DXCODE>298285004</ARI_DXCODE>
