        <ARI_Obsolete>false</ARI_Obsolete>
        <ARI_RefLink>SimpleTasks | http://simpletasks.org/what-is-life-like-with-vasculitis/</ARI_RefLink>
        <ARI_RefLink>Vasculitis Foundation | https://www.vasculitisfoundation.org/support/</ARI_RefLink>
        <ARI_SNOMED>60555002</ARI_SNOMED>
        <ARI_SurveyCode>HA</ARI_SurveyCode>
