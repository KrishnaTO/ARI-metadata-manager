        <ARI_OMIM>212750</ARI_OMIM>
        <ARI_OMOP>194992</ARI_OMOP>
        <ARI_ORPHANET>555</ARI_ORPHANET>
        <ARI_Obsolete>false</ARI_Obsolete>
        <ARI_PrevalenceDesc>Female 514965/100k; Male 190171/100k; F:M ratio 2.7079</ARI_PrevalenceDesc>
        <ARI_RefLink>Celiac Disease Foundation | https://celiac.org/</ARI_RefLink>
        <ARI_RefLink>Gluten Dude | http://glutendude.com/gluten-free-blog/</ARI_RefLink>
        <ARI_RefLink>Gluten Free Girl | https://glutenfreegirl.com/</ARI_RefLink>
        <ARI_RefLink>Link to Cleveland Clinic | https://my.clevelandclinic.org/health/diseases/14240-celiac-disease</ARI_RefLink>
