# /etc/systemd/system/ari-mm-staging-mapping-update.service
[Unit]
Description=Fetch the staging data repo's mapping TSVs into the staging copy's runtime files
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ariapp
ExecStart=/opt/ari-staging/ari-metadata-manager/deploy/update-mappings.sh
