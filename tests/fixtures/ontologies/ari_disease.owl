        <ARI_ClinicalSubtype>Erythema Nodosum, Idiopathic - No identifiable cause.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Erythema Nodosum, Secondary - Associated with infections or autoimmune diseases.</ARI_ClinicalSubtype>
        <ARI_DOID>0080750</ARI_DOID>
