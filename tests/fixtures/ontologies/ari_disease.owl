        <ARI_Obsolete>false</ARI_Obsolete>
        <ARI_PrevalenceDesc>Female 4290/100k; Male 4597/100k; F:M ratio 0.933217</ARI_PrevalenceDesc>
        <ARI_Pubmed>https://pubmed.ncbi.nlm.nih.gov/35522950/</ARI_Pubmed>
        <ARI_RefLink>Aplastic Anemia &amp; MDS International Foundation, Inc. | https://www.aamds.org/</ARI_RefLink>
        <ARI_RefLink>Link to Cleveland Clinic | https://my.clevelandclinic.org/health/diseases/14475-pure-red-cell-aplasia-prca</ARI_RefLink>
