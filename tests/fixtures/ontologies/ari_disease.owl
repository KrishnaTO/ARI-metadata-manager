        <ARI_DefSource>Walitt 2015; https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4575027/</ARI_DefSource>
        <ARI_ICD10>M79.7</ARI_ICD10>
        <ARI_ID>ARI:0001095</ARI_ID>
        <ARI_MESH>D005356</ARI_MESH>
        <ARI_MONDO>0005546</ARI_MONDO>
        <ARI_NCI>C87497</ARI_NCI>
        <ARI_OMOP>40405599</ARI_OMOP>
