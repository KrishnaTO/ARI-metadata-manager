        <ARI_ClinicalSubtype>Cryoglobulinemia Type I - Associated with monoclonal IgM or IgG.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Cryoglobulinemia Type II - Mixed monoclonal and polyclonal Ig.</ARI_ClinicalSubtype>
        <ARI_DXCODE>239947001</ARI_DXCODE>
        <ARI_DefSource>No studies found; CONFIRMED NO DATA Sept 2021</ARI_DefSource>
