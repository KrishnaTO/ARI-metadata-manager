        <ARI_ClinicalSubtype>Red Cell Aplasia, Autoimmune - Associated with immune-mediated suppression.</ARI_ClinicalSubtype>
        <ARI_DOID>1340</ARI_DOID>
        <ARI_DXCODE>50715003</ARI_DXCODE>
        <ARI_DefSource>Nakazawa 2022; https://pubmed.ncbi.nlm.nih.gov/35522950/</ARI_DefSource>
